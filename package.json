{
  "name": "sovereign-council-irys-bundle",
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./global.css -o ./dist.css --minify",
    "build:js": "esbuild ./index.ts --bundle --outfile=./irys-bundle.js --minify --format=iife --define:global=globalThis --define:process.env.NODE_ENV=\"production\" --alias:stream=stream-browserify --alias:crypto=crypto-browserify --alias:events=events --alias:buffer=buffer",
    "build": "npm run build:css && npm run build:js"
  },
  "dependencies": {
    "@irys/web-upload": "^0.0.4",
    "@irys/web-upload-ethereum": "^0.0.4",
    "@irys/web-upload-ethereum-ethers-v6": "^0.0.4",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.0",
    "ethers": "^6.13.4",
    "events": "^3.3.0",
    "stream-browserify": "^3.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.20.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.5"
  }
}